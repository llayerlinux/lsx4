#pragma once

#include <cstdint>

namespace Executor::BackendB {

// Generated by CMake from the exact Backend-B lowering/cache sources, their decoder/emitter
// dependencies, and the compiler/Android ABI configuration.  Unlike the ELF build-id this does
// not change when an unrelated HLE/GPU translation unit is rebuilt.
inline constexpr std::uint64_t kBackendBNativeCacheSourceAbiHash =
    0x@EXECUTOR_BACKEND_B_NATIVE_CACHE_ABI_HASH_64@ull;

} // namespace Executor::BackendB
